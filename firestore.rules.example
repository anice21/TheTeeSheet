rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // === LOGGING RULES ===
    // Allow authenticated users to write their own logs
    match /logs/app/{logType}/{logDocument=**} {
      // Users can write logs
      allow create: if request.auth != null;
      
      // Users can read their own logs
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.context.userId;
      
      // Admins can read all logs (optional - add admin check)
      // allow read: if request.auth != null && 
      //   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // === EXISTING RULES (example - replace with your actual rules) ===
    
    // Trips
    match /trips/{tripId} {
      allow read, write: if request.auth != null;
      
      // Players subcollection
      match /players/{playerId} {
        allow read, write: if request.auth != null;
      }
      
      // Scores subcollection  
      match /scores/{scoreId} {
        allow read, write: if request.auth != null;
      }
      
      // Rounds subcollection
      match /rounds/{roundId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Courses
    match /courses/{courseId} {
      allow read: if request.auth != null;
      // Only allow writes for specific admin users
      allow write: if request.auth != null && 
        request.auth.uid == '0BhToYrQ8ubS910OTUrkAYTXN873';
    }
    
    // Users
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
